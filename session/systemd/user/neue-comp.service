[Unit]
Description=neueOS compositor
Documentation=https://github.com/sophie-maney/neueos
# Stopping the session stops the compositor.
PartOf=neue-session.target
Before=neue-session.target
After=graphical-session-pre.target

[Service]
# `--notify` imports WAYLAND_DISPLAY and DISPLAY into the user manager, then sends READY=1.
Type=notify
NotifyAccess=main
# `--shell`: the compositor starts the desktop shell on a private socket and restarts it if
# it exits (ADR 0066).
ExecStart=/usr/bin/neue-comp --tty --notify --shell /usr/bin/neue-shell
# Stop through the compositor's own IPC so it leaves its loop and releases the seat; it has no
# SIGTERM handler (that needs a new dependency, ADR 0027). The environment is read when
# ExecStop runs, so `neuectl` sees the WAYLAND_DISPLAY that `--notify` imported. systemd
# sends KillSignal once ExecStop returns, and `quit` replies just before the compositor
# exits, so use a harmless one; SIGKILL follows after TimeoutStopSec if it hangs.
# systemd also runs ExecStop after the compositor quit by itself (Super+Q, `neuectl quit`);
# then there is no socket and `neuectl` fails, so `-` ignores its exit status.
ExecStop=-/usr/bin/neuectl quit
KillSignal=SIGCONT
TimeoutStartSec=30
TimeoutStopSec=10
# A crashed compositor ends the session (no restart): neue-session returns and greetd shows
# the login again.
Restart=no
Slice=session.slice
